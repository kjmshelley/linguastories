  "paragraphs": [
    {
      "paragraphId": "p1",
      "text": "山姆忙了一天后回到家。雨滴轻敲着窗户。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "他泡了热茶，拿出他的书。他的猫坐在他旁边。",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "山姆读了一页，又读了一页。屋子很安静，他觉得很舒服。",
      "sentences": []
    }
  ]
}
