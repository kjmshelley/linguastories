  "paragraphs": [
    {
      "paragraphId": "p1",
      "text": "샘은 긴 하루를 보내고 집에 돌아옵니다. 비가 오고 있습니다.",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "그는 따뜻한 차를 만듭니다. 책을 가져옵니다. 고양이가 그의 옆에 앉습니다.",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "샘은 책을 읽습니다. 집은 조용합니다. 그는 행복합니다.",
      "sentences": []
    }
  ]
}
