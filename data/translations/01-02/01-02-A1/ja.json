    {
      "paragraphId": "p1",
      "text": "サムは長い一日を終えて家に帰ります。雨が降っています。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "温かいお茶を入れます。本を持ってきます。猫が彼の隣に座ります。",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "サムは本を読みます。家は静かです。彼は幸せです。",
      "sentences": []
    }
  ]
}
