{
  "storyId": "01-01",
  "storyLevelId": "01-01-A1",
  "sourceLanguage": "zh-Hans",
  "paragraphs": [
    {
      "paragraphId": "p1",
      "text": "米娅很早就醒来了。阳光照在她的床上。她听见外面的鸟叫声。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "米娅走进厨房。爸爸正在泡茶。“早安。”他说。",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "他们坐在窗边吃面包。今天不用着急。米娅笑了。这是一个温暖、安静的早晨。",
      "sentences": []
    }
  ]
}
