  "paragraphs": [
    {
      "paragraphId": "p1",
      "text": "ミアは学校に遅れそうです。靴を履いて、バスまで走ります。友達が席を取ってくれています。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "ミアは座って、深呼吸します。「間に合った」と言います。",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "友だちはほほえんで学校を指さします。二人は一緒にバスを降ります。",
      "sentences": []
    }
  ]
}
