  "sourceLanguage": "zh-Hans",
  "paragraphs": [
    {
      "paragraphId": "p1",
      "text": "米娅上学迟到了。她穿上鞋，跑去搭公交车。朋友帮她留了一个座位。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "米娅坐下来，深深吸了一口气。“我赶上了。”她说。",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "她的朋友微笑着指向学校。两个朋友一起下了公交车。",
      "sentences": []
    }
  ]
}
