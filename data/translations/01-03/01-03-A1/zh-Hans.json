  "paragraphs": [
    {
      "paragraphId": "p1",
      "text": "班想去外面玩，但今天是下雨天。他望向窗外。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "妈妈给他一些纸和彩色蜡笔。“我们来画画吧。”她说。",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "班画了雨。他也画了蓝天和一个大大的黄色太阳。他把自己的画贴在墙上。",
      "sentences": []
    }
  ]
}
