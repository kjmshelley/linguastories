    {
      "paragraphId": "p1",
      "text": "今天早上天气凉凉的。班出门前穿上外套。他在公园里发现地上有红叶。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "班捡起一片叶子给爸爸看。它的颜色像苹果一样。",
      "sentences": []
    }
  ]
}
