{
  "storyId": "01-06",
  "storyLevelId": "01-06-A1",
  "sourceLanguage": "zh-Hans",
  "paragraphs": [
    {
      "paragraphId": "p1",
      "text": "星期天，山姆很晚才起床。他和姐姐一起做早餐。他们一边慢慢吃，一边听音乐。",
      "sentences": []
    },
    {
      "paragraphId": "p2",
      "text": "早餐后，他们一起洗碗。今天有时间什么都不做。",
      "sentences": []
    },
    {
      "paragraphId": "p3",
      "text": "山姆和姐姐坐在窗边。他们微笑着享受这个安静的早晨。",
      "sentences": []
    }
  ]
}
