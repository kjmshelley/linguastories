{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linguastories.app/schemas/language-manifest-1.0.0.json",
  "title": "LinguaStories curriculum language manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "languages"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetLanguage", "sourceLanguage", "targetScript", "targetLocale", "sourceLocale", "version", "schemaVersion", "minimumAppVersion", "packageStrategy", "path", "checksum", "bytes", "categoryBytes", "categories", "statistics"],
        "properties": {
          "targetLanguage": { "type": "string" }, "sourceLanguage": { "type": "string" }, "version": { "type": "string" }, "schemaVersion": { "type": "string" },
          "targetScript": { "type": "string" }, "targetLocale": { "type": "string" }, "sourceLocale": { "type": "string" }, "minimumAppVersion": { "type": "string" },
          "packageStrategy": { "const": "category-packages" },
          "path": { "type": "string", "pattern": "^[a-zA-Z0-9._/-]+$" }, "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 }, "categoryBytes": { "type": "integer", "minimum": 1 },
          "categories": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "slug", "name", "description", "order", "difficulty", "wordCount", "lessonCount", "prerequisiteCategoryId", "required", "path", "checksum", "bytes"], "properties": { "id": { "type": "string" }, "slug": { "type": "string" }, "name": { "type": "string" }, "description": { "type": "string" }, "order": { "type": "integer" }, "difficulty": { "type": "integer" }, "wordCount": { "type": "integer" }, "lessonCount": { "type": "integer" }, "prerequisiteCategoryId": { "type": ["string", "null"] }, "required": { "type": "boolean" }, "path": { "type": "string" }, "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 1 } } } },
          "statistics": { "type": "object" }, "migration": { "type": "object" }
        }
      }
    }
  }
}
